{
  "manifest_version": 3,
  "name": "Asuisui AI Web Bridge",
	"version": "1.0.28",
  "key": "",
  "description": "Reads answers and citations from selected Google AI Mode and ChatGPT web tabs for AsuisuiLLM.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1:43829/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/*", "https://google.com/*"],
      "js": ["version-check.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["version-check.js", "chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DesktopAI.Gui\**\*.cs" />
    <Compile Remove="DesktopAI.Core\**\*.cs" />
    <Compile Remove="verify-core\**\*.cs" />
    <Compile Remove="AsuisuiAssistantCore.cs" />
    <Compile Remove="GoogleAiModeSearchService.cs" />
    <Compile Remove="GoogleProfileSettings.cs" />
    <Compile Remove="MemoryService.cs" />
    <Compile Remove="WebSearchService.cs" />
    <Compile Remove="WebReaderService.cs" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.21" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DesktopAI.Core\DesktopAI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="google-ai-mode-extension\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RPA\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Invoke-UiVisionChatGPT.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

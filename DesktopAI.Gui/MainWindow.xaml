<Window x:Class="DesktopAI.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Asuisui AI" Height="720" Width="900" MinHeight="500" MinWidth="620" Background="#171A23" Foreground="#E6EAF2" Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Asuisui AI" FontSize="26" FontWeight="SemiBold" Foreground="#F1F3F8" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="MemoriesButton" Content="查看記憶" Click="Memories_Click"/>
        <Button x:Name="ProfileButton" Content="Chrome 設定檔" Click="Profile_Click"/>
        <Button x:Name="SettingsButton" Content="顯示設定" Click="Settings_Click"/>
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="對話模式" VerticalAlignment="Center" Foreground="#C3CAD8" Margin="4,0,10,0"/>
      <ComboBox x:Name="ModeBox" Width="185" SelectedIndex="0" Padding="8,5">
        <ComboBoxItem Content="一般聊天"/><ComboBoxItem Content="Google AI 搜尋"/><ComboBoxItem Content="ChatGPT 搜尋"/><ComboBoxItem Content="網頁搜尋"/>
      </ComboBox>
      <TextBlock Text="也可以輸入原有的 / 指令" VerticalAlignment="Center" Foreground="#A3ADBF" Margin="16,0,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#20242F" BorderBrush="#3A4151" BorderThickness="1" CornerRadius="10" Padding="14">
      <RichTextBox x:Name="Conversation" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" Foreground="#E6EAF2"/>
    </Border>
    <Border x:Name="ImagePreviewPanel" Grid.Row="3" Visibility="Collapsed" Background="#252936" BorderBrush="#42495C" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
      <DockPanel><Button x:Name="RemoveImageButton" DockPanel.Dock="Right" Content="移除圖片" Click="RemoveImage_Click"/><Image x:Name="ImagePreview" DockPanel.Dock="Left" MaxWidth="180" MaxHeight="90" Stretch="Uniform"/><TextBlock Text="圖片將在送出後傳給 Google AI；請先確認內容。" Foreground="#E6EAF2" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/></DockPanel>
    </Border>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="InputBox" Grid.Column="0" MinHeight="65" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_PreviewKeyDown" FontSize="15" Background="#252936" Foreground="#F1F3F8" CaretBrush="#F1F3F8" BorderBrush="#42495C"/>
      <Button x:Name="SendButton" Grid.Column="1" Content="送出" Click="Send_Click" MinWidth="75" Background="#5068C8" Foreground="White" BorderThickness="0"/>
      <Button x:Name="StopButton" Grid.Column="2" Content="停止" Click="Stop_Click" MinWidth="65"/>
    </Grid>
    <DockPanel Grid.Row="5" Margin="4,9,4,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="ScreenBox" Width="180" VerticalAlignment="Center" DisplayMemberPath="Label" DropDownOpened="ScreenBox_DropDownOpened" ToolTip="選擇要截取的螢幕"/><Button x:Name="ScreenshotButton" Content="截取螢幕" Click="Screenshot_Click"/><Button x:Name="ImageButton" Content="選擇圖片" Click="ChooseImage_Click"/></StackPanel><TextBlock x:Name="StatusText" Text="正在啟動…" Foreground="#C3CAD8" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
